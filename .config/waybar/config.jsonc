[
  {
    // "position": "left",
    "height": 0,
    "mode": "dock",
    // "spacing": 10,
    // "margin-top": 6,
    "margin-bottom": 0,
    // "margin-left": 200,
    // "margin-right": 200,
    "modules-left": [
      "custom/arch",
      "custom/updates",
      "hyprland/workspaces",
      "hyprland/window",
    ],
    "modules-center": ["custom/weather", "clock"],
    "modules-right": [
      "mpris",
      "group/minimized",
      "hyprland/language",
      "bluetooth",
      "network",
      "custom/vpn",
      "memory",
      "cpu",
      "pulseaudio",
      "custom/swaync",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "format": "{icon}: {windows}",
      "format-window-separator": "",
      "workspace-taskbar": {
        "enable": true,
        "update-active-window": true,
        "format": "{icon}",
        "icon-size": 20,
        "icon-theme": "YAMIS",
        "on-click-window": "${SCRIPTS}/focus-window.sh {address} {button}",
      },
    },
    "hyprland/window": {
      "format": "{}",
      "max-length": 60,
      "separate-outputs": true,
      "_inverted": false,
    },
    "clock": {
      "locale": "ru_RU.UTF8",
      "format": "\uf017 {:L%d %b <span color='#fff'>[%H:%M:%S]</span> %a}",
      "timezone": "Asia/Tomsk",
      "interval": 1,
      "tooltip-format": "{calendar}",
      "iso8601": true,
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "left",
        "on-scroll": 1,
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>{:%U}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
        },
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "tz_up",
        "on-scroll-down": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down",
      },
    },
    "hyprland/language": {
      "format": "{}",
      "format-en": "EN",
      "format-ru": "RU",
    },
    "cpu": {
      "format": "󰍛 {usage}%",
      "tooltip": true,
      "interval": 2,
      "on-click": "kitty --class floating-terminal -e btop",
    },
    "memory": {
      "format": "󰾆 {used:0.1f}G",
      "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
      "interval": 5,
      "on-click": "kitty --class floating-terminal -e btop",
    },
    "network": {
      "format-wifi": "󰖩 {signalStrength}%",
      "format-ethernet": "󰖩",
      "format-disconnected": "󰖪 Sin red",
      "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{essid} ({signalStrength}%)\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
      "on-click": "kitty --class floating-terminal -e impala",
      "interval": 5,
      "_inverted": false,
    },
    "custom/vpn": {
      "exec": "~/.local/bin/waybar-vpn",
      "interval": 2,
      "return-type": "json",
      "on-click": "kitty -e ~/.local/bin/vpn-manager-single",
      "tooltip": true
    },
    "bluetooth": {
      "format": "󰂯",
      "format-disabled": "󰂲",
      "format-connected": "󰂱 {device_alias}",
      "on-click": "kitty --class floating-terminal -e bluetui",
      "interval": 30,
      "tooltip": true,
      "_inverted": false,
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 mute",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"],
      },
      "on-click": "kitty --class floating-terminal -e wiremix",
      "on-click-right": "kitty --class floating-terminal -e yamusic",
      "scroll-step": 5,
      "_inverted": false,
    },
    "wireplumber": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰝟 mute",
      "on-click": "pavucontrol",
      "scroll-step": 5,
      "_inverted": false,
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "states": {
        "warning": 30,
        "critical": 15,
      },
    },
    "mpris": {
      "format": "{dynamic}",
      "format-paused": "{status_icon} <i>{dynamic}</i>",
      "interval": 1,
      "max-length": 100,
      "justify": "right",
      "_inverted": false,
      "status-icons": {
        "paused": "\uf04c",
      },
    },
    "custom/arch": {
      "format": "󰣇",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/arch_menu.xml",
      "menu-actions": {
        "config": "zeditor ~/.config/waybar/config.jsonc",
        "style": "zeditor ~/.config/waybar/style.css",
        "hyprland": "zeditor ~/.config/hypr/hyprland.lua",
        "configdir": "zeditor ~/.config/",
      },
    },
    "custom/weather": {
      "format": "{}",
      "exec": "$HOME/.config/waybar/scripts/weather.py",
      "return-type": "json",
      "interval": 3600,
      "tooltip": true,
      // "on-click": "mousam",
      "_inverted": false,
    },
    "custom/updates": {
      "exec": "count=$(checkupdates 2>/dev/null | wc -l); [ \"$count\" -gt 0 ] && echo '{\"text\":\"󰚰 '\"$count\"'\",\"class\":\"pending\"}' || echo '{\"text\":\"󰚰 0\",\"class\":\"updated\"}'",
      "return-type": "json",
      "interval": 60,
      "tooltip": false,
      "on-click": "kitty --class floating-terminal -e paru && gum spin --spinner globe --title 'Done! Press any key to close...' -- bash -c 'read -n 1 -s'",
    },
    "custom/swaync": {
      "tooltip": true,
      "format": "{icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
    "custom/power": {
      "format": "⏻",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "systemctl poweroff",
        "reboot": "reboot",
        "logout": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate",
      },
    },
    "custom/expand": {
      "tooltip": false,
      "format": "\udb84\udcaa",
    },

    "tray": {},

    "group/minimized": {
      "orientation": "horizontal",
      "modules": ["custom/expand", "tray"],
      "drawer": {
        "transition-duration": 500,
        "children-class": "minimized",
        "click-to-reveal": true,
      },
    },

    "name": "bar",
  },
]
